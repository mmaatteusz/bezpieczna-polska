[Unit]
Description=Bezpieczna Polska API container
After=network-online.target docker.service postgresql.service
Wants=network-online.target
Requires=docker.service postgresql.service

[Service]
Type=simple
EnvironmentFile=/opt/bezpieczna-polska/release.env
ExecStartPre=/usr/bin/test -f /etc/bezpieczna-polska/backend.env
ExecStartPre=-/usr/bin/docker rm -f bezpieczna-polska-api
ExecStart=/usr/bin/docker run --name bezpieczna-polska-api --network host --env-file /etc/bezpieczna-polska/backend.env -e BUILD_SHA=${BUILD_SHA} bp-api:${BUILD_SHA}
ExecStop=/usr/bin/docker stop -t 20 bezpieczna-polska-api
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
